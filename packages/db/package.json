{
  "name": "@oryvia/db",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "tsx --env-file-if-exists=../../.env src/local-postgres.ts",
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "seed:dev": "tsx src/seed-dev.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "embedded-postgres": "18.6.0-beta.19",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "dotenv": "^17.2.0"
  }
}
