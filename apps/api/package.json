{
  "name": "@oryvia/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "start": "tsx --env-file-if-exists=../../.env src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "seed:reference": "tsx --env-file-if-exists=../../.env src/scripts/seed-reference.ts",
    "seed:dev": "tsx --env-file-if-exists=../../.env src/scripts/seed-dev.ts",
    "bootstrap:owner": "tsx --env-file-if-exists=../../.env src/scripts/bootstrap-owner.ts",
    "worker": "tsx --env-file-if-exists=../../.env src/worker.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "@oryvia/contracts": "*",
    "@oryvia/db": "*",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.20",
    "better-auth": "1.7.14",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3",
    "unplugin-swc": "^1.5.5",
    "vitest": "^5.0.5"
  }
}
