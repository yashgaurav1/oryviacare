# Copy to .env and fill in. Never commit .env. Values here are placeholders only.

# ── Database ──────────────────────────────────────────────
# Local: `npm run db:start` runs real PostgreSQL (embedded-postgres) on port 54329.
# The password is LOCAL_PG_PASSWORD (required; choose any local-only value and use it in DATABASE_URL too).
LOCAL_PG_PORT=54329
LOCAL_PG_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://postgres:change-me-local-only@127.0.0.1:54329/oryvia_app
# Used by integration tests; tests truncate data here.
TEST_DATABASE_URL=postgresql://postgres:change-me-local-only@127.0.0.1:54329/oryvia_app_test

# ── Auth (Better Auth) ────────────────────────────────────
# 32+ random bytes, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
BETTER_AUTH_SECRET=
# Public origin that serves both web and /api (single origin).
PUBLIC_ORIGIN=http://localhost:3000

# ── API / web wiring ──────────────────────────────────────
API_PORT=4000
# Next.js rewrites /api/* to this backend URL (server-side only).
API_INTERNAL_URL=http://127.0.0.1:4000

# ── Storage ───────────────────────────────────────────────
# local = filesystem adapter under ./storage (public/ and private/ prefixes).
STORAGE_DRIVER=local

# ── Payments (Razorpay) — leave blank until merchant supplies TEST keys ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Development only ──────────────────────────────────────
# Enables the clearly-labelled "development manual order" payment method. Must be false in production.
ALLOW_DEV_MANUAL_PAYMENT=true
NODE_ENV=development
